# Builds Skillscout for Arch Linux from this checkout's committed linux-port branch:
#
#   cd Linux/arch && makepkg -si
#
# Swift comes from the AUR's swift-bin. With a toolchain from swift.org on your PATH instead, run
# makepkg -si --nodeps, and keep gtk4, libadwaita and sqlite installed.

pkgname=skillscout
pkgver=1.4.0
pkgrel=1
pkgdesc="Find the skills your coding agents load, see which agents can use each one, and count how often you use them"
arch=('x86_64' 'aarch64')
url="https://github.com/flaviocopes/skillscout"
license=('MIT')
depends=('gtk4' 'libadwaita' 'glib2' 'sqlite' 'gcc-libs' 'glibc')
makedepends=('swift-language' 'git' 'patchelf')
optdepends=(
  'claude-code: Explain, Find repeated tasks, Draft and Merge with AI through Claude Code'
  'openai-codex: the same AI features through the Codex CLI'
)
options=('!lto' '!debug')
source=("$pkgname::git+file://${startdir%/Linux/arch}#branch=linux-port")
sha256sums=('SKIP')

build() {
  cd "$pkgname"
  swift build -c release
}

package() {
  cd "$pkgname"
  SKIP_BUILD=1 PREFIX=/usr DESTDIR="$pkgdir" Linux/scripts/install.sh
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
